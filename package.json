{
  "name": "rexp-studio",
  "version": "0.1.0",
  "description": "CLI and loopback browser editor for Relution .rexp archives, Apple payloads, baseline data, and read-only device audits.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "bin": {
    "rexp": "./dist/src/cli.js"
  },
  "scripts": {
    "build:node": "rm -rf dist && tsc -p tsconfig.json",
    "build:web": "rm -rf dist-web && vite build",
    "build:demo": "rm -rf dist-demo && vite build --mode demo",
    "check:bundle:web": "node tools/check-web-bundle-budget.mjs",
    "build": "pnpm build:node && pnpm build:web",
    "check:loc": "node tools/check-loc.mjs",
    "check:duplicates": "jscpd --config .jscpd.json --cross-formats js-ts .",
    "check:hygiene": "pnpm check:loc && pnpm check:duplicates",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "knip": "knip --config knip.json",
    "python:clean-cache": "find tests/python tools -type d -name __pycache__ -prune -exec rm -rf {} + && find tests/python tools -type f \\( -name '*.pyc' -o -name '*.pyo' \\) -delete",
    "python:lint": "uv run --locked ruff check .",
    "python:test": "uv run --locked pytest --ignore=.env.example",
    "test:node:built": "node --test dist/tests/*.test.js dist/tests/relution-docker/*.test.js",
    "test:node": "pnpm build:node && pnpm test:node:built",
    "test:fuzz:built": "node --test dist/tests/fuzz.test.js",
    "test:fuzz": "pnpm build:node && pnpm test:fuzz:built",
    "test:meta:built": "node --test dist/tests/meta/*.test.js",
    "test:meta": "pnpm build:node && pnpm test:meta:built",
    "test:web": "vitest run",
    "test": "pnpm test:node && pnpm test:web",
    "verify:ci": "pnpm python:clean-cache && pnpm check:hygiene && pnpm typecheck && pnpm knip && pnpm build && pnpm check:bundle:web && pnpm test:node:built && pnpm test:web && pnpm python:lint && pnpm python:test && pnpm test:meta:built && pnpm python:clean-cache",
    "verify:pre-pr": "pnpm verify:ci && pnpm codacy:cloud:inspect && pnpm codacy:cloud",
    "codacy:cloud-config": "node tools/run_codacy_cloud.mjs config",
    "codacy:cloud:inspect": "node tools/run_codacy_cloud.mjs inspect",
    "codacy:cloud": "node tools/run_codacy_cloud.mjs analyze",
    "playwright:ci": "env -u FORCE_COLOR PLAYWRIGHT_BROWSERS_PATH=/tmp/ms-playwright playwright",
    "test:e2e:web": "pnpm build && pnpm playwright:ci test",
    "test:e2e:demo": "pnpm playwright:ci test -c playwright.demo.config.ts",
    "screenshots:readme": "pnpm build && pnpm playwright:ci test -c playwright.readme.config.ts",
    "test:e2e:relution": "pnpm build:node && node --test dist/tests/relution-docker/relution-docker.e2e.js",
    "test:e2e:relution-dashboard": "pnpm build:node && node --test dist/tests/relution-docker/relution-dashboard-docker.e2e.js",
    "rexp:evidence": "pnpm build && node tools/build_windows_rexp_evidence.mjs",
    "rexp:built": "node dist/src/cli.js",
    "rexp": "pnpm build && node dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "fast-check": "4.9.0",
    "jscpd": "5.0.14",
    "jsdom": "^30.0.1",
    "knip": "6.32.2",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "js-yaml": "^4.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
